{
  "name": "starter-fullstack",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --parallel --filter next --filter nest dev",
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "lint": "pnpm --recursive lint",
    "format": "pnpm --recursive format",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
